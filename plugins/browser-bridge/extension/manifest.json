{
  "manifest_version": 3,
  "name": "谷谷嘎嘎正在控制你的浏览器",
  "version": "1.9.0",
  "description": "谷谷嘎嘎把本机 Edge / Chrome 交给 MCP 服务驱动，保留登录态；控制默认在专属后台窗口的紫色标签组内运行，不抢焦点、不打扰用户；内置常驻页面鼠标与悬浮录制胶囊（RPA 录制回放）。",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "谷谷嘎嘎正在控制你的浏览器 · antigravity浏览器控制",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "谷谷嘎嘎"
}

{
  "mcpServers": {
    "desktop": {
      "command": "python3",
      "args": ["${PLUGIN_ROOT}/scripts/mcp_server.py"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "CU_DATA_DIR": "${PLUGIN_DATA}",
        "CU_POLICY_FILE": "${PLUGIN_DATA}/policy.json",
        "CU_AUDIT_DIR": "${PLUGIN_DATA}/audit",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "timeoutSeconds": 120
    }
  }
}
